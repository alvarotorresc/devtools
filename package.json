{
  "name": "devtools",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Developer tools that run in your browser: JSON, UUID, JWT, Base64, hashes, regex, diff and more.",
  "author": "Álvaro TC",
  "license": "MIT",
  "homepage": "https://devtools.alvarotc.com",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --ignore-lock",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "check:css": "node scripts/check-css.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "lint": "eslint . && prettier --check src e2e",
    "format": "prettier --write src e2e",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "og": "node scripts/og.mjs",
    "media": "node media/shots/shots.mjs && node media/shots/labels.mjs && node media/shots/promo.mjs",
    "media:shots": "node media/shots/shots.mjs",
    "media:readme": "node media/shots/readme.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucide/svelte": "^1.61.0",
    "astro": "^7.4.2",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "qrcode-generator": "^2.0.4",
    "semver": "^7.8.5",
    "svelte": "^5.57.2",
    "ua-parser-js": "^1.0.41",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/semver": "^7.8.0",
    "@types/ua-parser-js": "^0.7.39",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "^6",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
