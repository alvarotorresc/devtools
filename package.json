{
  "name": "devtools",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Developer tools that run in your browser: JSON, UUID, JWT, Base64, hashes, regex, diff and more.",
  "author": "Álvaro TC",
  "license": "MIT",
  "homepage": "https://devtools.alvarotc.com",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --ignore-lock",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "check:css": "node scripts/check-css.mjs",
    "lint": "eslint . && prettier --check src e2e",
    "format": "prettier --write src e2e",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucide/svelte": "^1.48.0",
    "astro": "^7.3.5",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
