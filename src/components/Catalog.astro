---
import ToolList from './ToolList.astro';
import Icon from '../ui/Icon.svelte';
import { categoryHref } from '../i18n';
import { toolsInCategory, visibleCategories } from '../tools/registry';
import type { Locale } from '../tools/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="catalog-frame">
  <div class="catalog">
    {visibleCategories().map((c) => {
      const list = toolsInCategory(c.id);
      return (
        <section class="module" aria-labelledby={`catalog-${c.id}`}>
          <header class="module-head">
            <span class="module-icon">
              <Icon name={c.icon} size={20} />
            </span>
            <span class="module-title">
              <h3 id={`catalog-${c.id}`}>
                <a href={categoryHref(locale, c)}>{c.name[locale]}</a>
              </h3>
              <span class="module-count" aria-hidden="true">
                {String(list.length).padStart(2, '0')}
              </span>
            </span>
            <p class="module-desc">{c.description[locale]}</p>
          </header>
          <ToolList locale={locale} tools={list} compact idPrefix="catalog-desc" />
        </section>
      );
    })}
  </div>
</div>

<style>
  .catalog-frame {
    container-type: inline-size;
  }
  .catalog {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    align-items: stretch;
  }
  /* Between two and four columns auto-fit leaves a lone module on its own row (3 + 1).
     In that range two columns read as a deliberate 2 x 2 grid. */
  @container (min-width: 800px) and (max-width: 1139px) {
    .catalog {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .module {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .module-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 6px 14px;
    padding: 20px 20px 16px;
    border-bottom: 1px solid var(--border);
  }
  .module-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: var(--well);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--inset);
    color: var(--accent-text);
  }
  .module-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
  }
  h3 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .module-count {
    flex-shrink: 0;
    padding: 2px 8px;
    background: var(--well);
    border-radius: var(--radius-pill);
    font: 500 12.5px/1.4 var(--font-mono);
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }
  .module-desc {
    grid-column: 1 / -1;
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-dim);
  }
  /* The heading opens the category page; a quiet underline says it is a link. */
  h3 a {
    color: inherit;
    text-decoration: underline 1px var(--border-strong);
    text-underline-offset: 5px;
    transition:
      color 140ms,
      text-decoration-color 140ms;
  }
  h3 a:hover {
    color: var(--accent-text);
    text-decoration-color: currentColor;
  }
</style>
