---
import Icon from '../ui/Icon.svelte';
import { toolHref } from '../i18n';
import { toolsInCategory, visibleCategories } from '../tools/registry';
import type { Locale } from '../tools/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="catalog-frame">
  <div class="catalog">
    {visibleCategories().map((c) => {
      const list = toolsInCategory(c.id);
      return (
        <section class="module" aria-labelledby={`catalog-${c.id}`}>
          <header class="module-head">
            <span class="module-icon">
              <Icon name={c.icon} size={20} />
            </span>
            <span class="module-title">
              <h3 id={`catalog-${c.id}`}>{c.name[locale]}</h3>
              <span class="module-count" aria-hidden="true">
                {String(list.length).padStart(2, '0')}
              </span>
            </span>
            <p class="module-desc">{c.description[locale]}</p>
          </header>
          <ul>
            {list.map((tool) => (
              <li>
                <a
                  class="tool-row"
                  href={toolHref(locale, tool)}
                  aria-label={tool.name[locale]}
                  aria-describedby={`catalog-desc-${tool.id}`}
                >
                  <span class="row-icon">
                    <Icon name={tool.icon} size={18} />
                  </span>
                  <span class="row-text">
                    <span class="row-name">{tool.name[locale]}</span>
                    <span class="row-desc" id={`catalog-desc-${tool.id}`}>
                      {tool.description[locale]}
                    </span>
                  </span>
                  <span class="row-chevron">
                    <Icon name="chevron-right" size={18} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </div>
</div>

<style>
  .catalog-frame {
    container-type: inline-size;
  }
  .catalog {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    align-items: stretch;
  }
  /* Between two and four columns auto-fit leaves a lone module on its own row (3 + 1).
     In that range two columns read as a deliberate 2 x 2 grid. */
  @container (min-width: 800px) and (max-width: 1139px) {
    .catalog {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .module {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .module-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 6px 14px;
    padding: 20px 20px 16px;
    border-bottom: 1px solid var(--border);
  }
  .module-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: var(--well);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--inset);
    color: var(--accent-text);
  }
  .module-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
  }
  h3 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .module-count {
    flex-shrink: 0;
    padding: 2px 8px;
    background: var(--well);
    border-radius: var(--radius-pill);
    font: 500 12.5px/1.4 var(--font-mono);
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }
  .module-desc {
    grid-column: 1 / -1;
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-dim);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tool-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    min-height: 60px;
    padding: 8px 12px;
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: background-color 140ms var(--ease);
  }
  .tool-row:hover {
    background: var(--raised);
  }
  .tool-row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    background: var(--raised);
  }
  .row-icon {
    display: inline-flex;
    color: var(--accent-text);
  }
  .row-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .row-name {
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.35;
  }
  .row-desc {
    display: block;
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row-chevron {
    display: inline-flex;
    color: var(--text-dim);
    transition:
      transform 160ms var(--ease),
      color 160ms;
  }
  .tool-row:hover .row-chevron,
  .tool-row:focus-visible .row-chevron {
    color: var(--accent-text);
    transform: translateX(3px);
  }
</style>
