---
import Icon from '../ui/Icon.svelte';
import { toolHref } from '../i18n';
import type { Locale, ToolMeta } from '../tools/types';

interface Props {
  locale: Locale;
  tools: ToolMeta[];
  /**
   * Catalog cards: the short name as link text and a one-line description.
   * Otherwise the link reads as the tool's heading and the description wraps.
   */
  compact?: boolean;
  /** Prefix for description ids, unique per page. */
  idPrefix: string;
}
const { locale, tools, compact = false, idPrefix } = Astro.props;
---

<ul class:list={['tool-list', { compact }]}>
  {tools.map((tool) => {
    const descId = `${idPrefix}-${tool.id}`;
    return (
      <li>
        <a
          class="tool-row"
          href={toolHref(locale, tool)}
          aria-label={compact ? tool.name[locale] : undefined}
          aria-describedby={descId}
        >
          <span class="row-icon">
            <Icon name={tool.icon} size={18} />
          </span>
          <span class="row-text">
            <span class="row-name">{compact ? tool.name[locale] : tool.heading[locale]}</span>
            <span class="row-desc" id={descId}>
              {tool.description[locale]}
            </span>
          </span>
          <span class="row-chevron">
            <Icon name="chevron-right" size={18} />
          </span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .tool-list {
    list-style: none;
    margin: 0;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tool-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    min-height: 60px;
    padding: 8px 12px;
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: background-color 140ms var(--ease);
  }
  .tool-row:hover {
    background: var(--raised);
  }
  .tool-row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    background: var(--raised);
  }
  .row-icon {
    display: inline-flex;
    color: var(--accent-text);
  }
  .row-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .row-name {
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.35;
  }
  .row-desc {
    display: block;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-dim);
    text-wrap: pretty;
  }
  .compact .row-desc {
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tool-list:not(.compact) .tool-row {
    padding: 12px 14px;
  }
  .tool-list:not(.compact) .row-desc {
    margin-top: 2px;
  }
  .row-chevron {
    display: inline-flex;
    color: var(--text-dim);
    transition:
      transform 160ms var(--ease),
      color 160ms;
  }
  .tool-row:hover .row-chevron,
  .tool-row:focus-visible .row-chevron {
    color: var(--accent-text);
    transform: translateX(3px);
  }
</style>
