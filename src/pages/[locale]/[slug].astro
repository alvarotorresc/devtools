---
import CategoryPage from '../../components/CategoryPage.astro';
import ToolPage from '../../components/ToolPage.astro';
import { categoryById, toolById, tools, visibleCategories } from '../../tools/registry';
import { LOCALES, type CategoryId, type Locale } from '../../tools/types';

// One segment under the locale serves both tools and category pages. Their
// slugs never collide: registry.test.ts checks it for every locale.
type Props = { kind: 'tool'; toolId: string } | { kind: 'category'; categoryId: CategoryId };

export function getStaticPaths() {
  return LOCALES.flatMap((locale) => [
    ...tools.map((tool) => ({
      params: { locale, slug: tool.slug[locale] },
      props: { kind: 'tool', toolId: tool.id } as const,
    })),
    ...visibleCategories().map((c) => ({
      params: { locale, slug: c.slug[locale] },
      props: { kind: 'category', categoryId: c.id } as const,
    })),
  ]);
}

const locale = Astro.params.locale as Locale;
const page = Astro.props;
---

{page.kind === 'tool' ? (
  <ToolPage locale={locale} tool={toolById(page.toolId)!} />
) : (
  <CategoryPage locale={locale} category={categoryById(page.categoryId)} />
)}
