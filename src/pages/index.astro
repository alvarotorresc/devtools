---
import '../styles/global.css';
import { homeHref } from '../i18n';

// On Netlify this page is never served: the edge function root-language
// answers "/" with a 302 to /es or /en. It only runs without it (astro
// preview, e2e) and repeats the same choice in the browser:
// stored language, then the browser's languages, then English. The #hash goes
// along so the home page can forward old /#tool links.
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>devtools</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (() => {
        const ok = (l) => (l === 'es' || l === 'en' ? l : null);
        let stored = null;
        try {
          stored = ok(localStorage.getItem('devtools:locale'));
        } catch {
          // Storage blocked: try the cookie.
        }
        if (!stored) stored = ok((document.cookie.match(/(?:^|;\s*)nf_lang=([^;]*)/) || [])[1]);
        const browser = (navigator.languages || [navigator.language])
          .map((l) => ok(String(l).toLowerCase().split('-')[0]))
          .find(Boolean);
        location.replace('/' + (stored || browser || 'en') + location.hash);
      })();
    </script>
  </head>
  <body>
    <main class="root">
      <p>
        <a href={homeHref('es')} hreflang="es" lang="es">
          devtools en español
        </a>
        <span aria-hidden="true">·</span>
        <a href={homeHref('en')} hreflang="en">
          devtools in English
        </a>
      </p>
    </main>
  </body>
</html>

<style>
  .root {
    padding: 48px 16px;
    text-align: center;
  }
  .root p {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 12px;
    margin: 0;
  }
</style>
